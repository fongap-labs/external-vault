# Mark generated public artifacts as generated for GitHub Linguist.
output/** linguist-generated=true

# Normalize workflow and script text for Linux runners.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep the verbatim upstream licence texts in their original line endings.
licenses/adfilter/*.txt text eol=lf
tools/r-base/LICENSE text eol=lf

# The changelog only grows, and every change adds its entry at the top of the
# unreleased section. Two changes that are open at the same time therefore touch the
# same lines, and the merge stops with a conflict that has to be resolved by hand.
# Unioning keeps the entries of both sides, which is what an append-only changelog
# wants anyway.
CHANGELOG.md merge=union