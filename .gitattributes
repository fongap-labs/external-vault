# Mark generated public artifacts as generated for GitHub Linguist.
output/** linguist-generated=true

# Normalize workflow and script text for Linux runners.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep the verbatim upstream licence texts in their original line endings.
licenses/adfilter/*.txt text eol=lf
tools/r-base/LICENSE text eol=lf
