{
  "schema_version": "1",
  "operations": {
    "ci": {
      "jobs": [
        {
          "id": "linux",
          "runner_profile": "linux-standard",
          "command": [
            "bash",
            "{control_root}/.github/scripts/central-ci.sh",
            "{target_root}"
          ],
          "timeout_minutes": 180,
          "capability_requests": [
            "source.read"
          ]
        }
      ]
    }
  }
}
